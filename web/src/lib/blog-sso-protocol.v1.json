{
  "version": 1,
  "description": "Blog SSO bookmark/return-route contract shared by the issuer (Laisky/laisky-blog-graphql web/src/lib/blog-sso-protocol.v1.json, canonical) and the consumer (Laisky/laisky-blog). Copies must stay byte-identical; change both repositories together and bump version on any semantic change. accept: the issuer bootstraps with exactly returnPath and the consumer accepts returnPath unchanged. reject=route: both sides reject the route derived from target. reject=origin: the issuer rejects the target authority or scheme before any route is derived.",
  "markers": [
    "sso_token",
    "sso_code",
    "sso_state",
    "sso_flow",
    "sso_challenge",
    "sso_challenge_method",
    "code_verifier",
    "sso_verifier",
    "sso_start",
    "sso_return",
    "sso_issuer"
  ],
  "maxReturnPathLength": 2048,
  "cases": [
    { "target": "https://blog.laisky.com", "returnPath": "/" },
    { "target": "https://blog.laisky.com/p/article/?view=compact#intro", "returnPath": "/p/article/?view=compact#intro" },
    { "target": "http://blog.laisky.com/p/article/", "returnPath": "/p/article/" },
    { "target": "https://BLOG.LAISKY.COM:443/about/site/?view=compact#intro", "returnPath": "/about/site/?view=compact#intro" },
    { "target": "https://blog.laisky.com/p/article/?tag=a&tag=b", "returnPath": "/p/article/?tag=a&tag=b" },
    { "target": "https://blog.laisky.com/p/article/#/section?view=compact", "returnPath": "/p/article/#/section?view=compact" },
    { "target": "https://blog.laisky.com/p/article/#/section?note=sso_token", "returnPath": "/p/article/#/section?note=sso_token" },
    { "target": "https://blog.laisky.com/p/article/?view=compact#intro#details", "returnPath": "/p/article/?view=compact#intro#details" },
    { "target": "https://blog.laisky.com/p/article/#sso_tokenizer", "returnPath": "/p/article/#sso_tokenizer" },
    { "target": "https://blog.laisky.com/p/article/?sso_token=old", "reject": "route" },
    { "target": "https://blog.laisky.com/p/article/?SSO_TOKEN=old", "reject": "route" },
    { "target": "https://blog.laisky.com/p/article/?sso%5Ftoken=old", "reject": "route" },
    { "target": "https://blog.laisky.com/p/article/?sso_token=a&sso_token=b", "reject": "route" },
    { "target": "https://blog.laisky.com/p/article/?sso_code=old", "reject": "route" },
    { "target": "https://blog.laisky.com/?sso_start=1&sso_return=/", "reject": "route" },
    { "target": "https://blog.laisky.com/p/article/#sso_token=old", "reject": "route" },
    { "target": "https://blog.laisky.com/p/article/#Sso_Return=%2F", "reject": "route" },
    { "target": "https://blog.laisky.com/p/article/#/comments?sso_token=SYNTHETIC_CANARY", "reject": "route" },
    { "target": "https://blog.laisky.com/p/article/#/article?x=1&SSO_CODE=old", "reject": "route" },
    { "target": "https://blog.laisky.com/p/article/#!/article?sso_state=old", "reject": "route" },
    { "target": "https://blog.laisky.com/p/article/#/article?sso%5Ftoken=old", "reject": "route" },
    { "target": "https://blog.laisky.com/p/article/#/article#sso_token=old", "reject": "route" },
    { "target": "https://blog.laisky.com/p/article/#intro#sso_state=old", "reject": "route" },
    { "target": "https://user@blog.laisky.com/", "reject": "origin" },
    { "target": "https://blog.laisky.com:444/", "reject": "origin" },
    { "target": "http://blog.laisky.com:8080/", "reject": "origin" },
    { "target": "https://blog.laisky.com./", "reject": "origin" }
  ]
}
