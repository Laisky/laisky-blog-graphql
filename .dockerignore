# Never send the real checkout's Git store, including unrelated packed/dangling objects.
.git
# Only the explicit public shallow-HEAD preparation is allowed for native Go stamping.
.docker-build-git/*
!.docker-build-git/HEAD
!.docker-build-git/index
!.docker-build-git/shallow
!.docker-build-git/refs
!.docker-build-git/objects
.docker-build-git/objects/info
**/.DS_Store

# Go build artifacts
bin/
*.exe
*.out

# Node artifacts
node_modules
web/node_modules
web/dist
web/.next
web/.nuxt
web/.cache

# Editor directories
.vscode
.idea
